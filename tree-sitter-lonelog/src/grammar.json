      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[+-]\\d+"
        }
      }
    },
    "multiplier": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "×\\d+"
        }
      }
    },
    "transition": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "→"
            },
            {
              "type": "STRING",
              "value": "->"
            }
          ]
        }
      }
    },
    "_tag_word": {
      "type": "PATTERN",
      "value": "[^|\\]\\s\\d+\\-×→]+"
    },
    "_tag_number": {
      "type": "PATTERN",
      "value": "\\d+"
    },
    "_tag_punctuation": {
      "type": "PATTERN",
      "value": "[+\\-×]"
    },
    "block_tag": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "\\[\\/?[A-Z][A-Z ]+[A-Z]\\]"
        }
      }
    },
    "meta_note": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "\\([a-z][a-z ]*:[^)\\n]*\\)"
        }
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "\"[^\"\\n]*\""
            },
            {
              "type": "PATTERN",
              "value": "“[^”\\n]*”"
            }
          ]
        }
      }
    },
    "dice": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "\\d*d(\\d+|%|F(\\.\\d+)?)(!!?p?((>=|<=|!=|<|>|=)\\d+)?|k[hl]?\\d+|d[hl]?\\d+|ro?((>=|<=|!=|<|>|=)\\d+)?|uo?((>=|<=|!=|<|>|=)\\d+)?|min\\d+|max\\d+|c[sf]((>=|<=|!=|<|>|=)\\d+)?|s[ad]?|(>=|<=|!=|<|>|=)\\d+(f(>=|<=|!=|<|>|=)\\d+)?)*([+-]\\d+)?(=\\d+)?"
        }
      }
    },
    "comparison": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "vs"
