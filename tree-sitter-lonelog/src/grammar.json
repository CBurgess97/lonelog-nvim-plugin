              "value": "]"
            },
            {
              "type": "SYMBOL",
              "name": "_tag_close_line"
            }
          ]
        }
      ]
    },
    "_tag_continuation": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "\\r?\\n[ \\t]+"
        }
      }
    },
    "_tag_close_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "\\r?\\n\\]"
        }
      }
    },
