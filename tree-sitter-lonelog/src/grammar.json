        "type": "PREC",
        "value": 3,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "\"[^\"\\n]*\""
            },
            {
              "type": "PATTERN",
              "value": "“[^”\\n]*”"
            }
