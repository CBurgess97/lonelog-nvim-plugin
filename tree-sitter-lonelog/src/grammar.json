            {
              "type": "STRING",
              "value": ">="
            },
            {
              "type": "STRING",
              "value": "<="
            },
            {
              "type": "STRING",
              "value": "≥"
            },
            {
              "type": "STRING",
              "value": "≤"
            }
          ]
        }
      }
    },
    "_number": {
      "type": "PATTERN",
      "value": "\\d+"
