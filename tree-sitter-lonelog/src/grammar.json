      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[a-z][A-Za-z ]*:"
        }
      }
    },
    "tag_text": {
      "type": "PATTERN",
      "value": "[^|\\]\\n\\d \\t][^|\\]\\n\\d]*|\\d+"
