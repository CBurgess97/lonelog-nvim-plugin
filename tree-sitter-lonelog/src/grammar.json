      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[A-Za-z]+:"
        }
      }
    },
    "_tag_break": {
      "type": "CHOICE",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "|"
          },
          "named": true,
          "value": "tag_separator"
        },
        {
          "type": "SYMBOL",
          "name": "_tag_continuation"
        }
      ]
    },
    "_tag_continuation": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "\\r?\\n[ \\t]+"
        }
      }
    },
    "_tag_close_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "\\r?\\n\\]"
        }
      }
    },
    "_tag_piece": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "progress"
        },
        {
          "type": "SYMBOL",
          "name": "dice"
        },
        {
          "type": "SYMBOL",
          "name": "delta"
        },
        {
          "type": "SYMBOL",
          "name": "multiplier"
        },
        {
          "type": "SYMBOL",
          "name": "transition"
        },
        {
          "type": "SYMBOL",
          "name": "_tag_word"
        },
        {
          "type": "SYMBOL",
          "name": "_tag_number"
        },
        {
          "type": "SYMBOL",
          "name": "_tag_punctuation"
        }
      ]
    },
