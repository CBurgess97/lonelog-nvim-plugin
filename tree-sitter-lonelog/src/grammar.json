    "_word": {
      "type": "PATTERN",
      "value": "[^\\s\\[\\]()\"“”\\d=]+"
    },
    "_punctuation": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
